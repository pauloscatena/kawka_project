<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Skat.KawkaProject.Core\Skat.KawkaProject.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.3.0" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project drive WaitForTopicDeletionAsync with scripted answers and zero
         delays. Timing that loop through the public API does not work: a full recreate spends
         hundreds of milliseconds building librdkafka clients, swamping the intervals under test. -->
    <InternalsVisibleTo Include="Skat.KawkaProject.Kafka.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
